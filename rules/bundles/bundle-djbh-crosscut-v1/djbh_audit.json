                    { "type": "set", "params": { "attr": "__exec__.payload.data.result.reason", "operation": "set", "value": "等保2.0三级 §8.1.4.3.c：审计记录未受保护" } }
                  ],
                  "on_false": [
                    { "type": "set", "params": { "attr": "__exec__.payload.data.result.decision", "operation": "set", "value": "compliant" } }
                  ]
                }
              }
            ]
          }
        }
      ],
      "on_false": []
    }
  }
]
